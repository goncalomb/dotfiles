#!/usr/bin/env bash

# /// dotfiles
# description = "Run Ansible playbooks (`playbook.ya?ml` + `playbook-*.ya?ml`) with optional `inventory.ya?ml`, after installing `requirements.ya?ml`."
# author = "goncalomb"
# year = "2025-2026"
# tags = ["stable"]
# ///

set -euo pipefail
shopt -s nullglob

ARGUMENTS=()
PLAYBOOKS=()
DD=
for ARG in "$@"; do
    [ "$ARG" == "--" ] && DD=1 && continue
    [ -z "$DD" ] && ARGUMENTS+=("$ARG") || PLAYBOOKS+=("$ARG")
done

[ ${#PLAYBOOKS[@]} -eq 0 ] && PLAYBOOKS+=(playbook[.]y{,a}ml playbook-*.y{,a}ml)
[ ${#PLAYBOOKS[@]} -eq 0 ] && PLAYBOOKS+=(playbook.yml) # default

REQ=(requirements[.]y{,a}ml)
if [ ${#REQ[@]} -gt 0 ]; then
    echo "requirements:"
    echo "  ${REQ[0]}"
fi
INV=(inventory[.]y{,a}ml)
if [ ${#INV[@]} -gt 0 ]; then
    echo "inventory:"
    echo "  ${INV[0]}"
    ARGUMENTS+=("-i" "${INV[0]}")
fi
echo "playbooks:"
for PB in "${PLAYBOOKS[@]}"; do
    echo "  $PB"
done

export ANSIBLE_INVENTORY_UNPARSED_WARNING=False
export ANSIBLE_LOCALHOST_WARNING=False

[ ${#REQ[@]} -gt 0 ] && ansible-galaxy install -r "${REQ[0]}"
exec ansible-playbook "${ARGUMENTS[@]}" -- "${PLAYBOOKS[@]}"
